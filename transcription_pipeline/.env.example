# Local Hugging Face Whisper model settings.
WHISPER_MODEL=small
WHISPER_FALLBACK_MODELS=base

# Public Whisper models do not require a Hugging Face token.
# Uncomment and replace only if your Hugging Face account needs authenticated access.
# HF_TOKEN=hf_your_token_here

# Optional text-only correction. Leave commented to keep correction disabled.
# OPENAI_API_KEY=sk-your_key_here
OPENAI_TEXT_MODEL=gpt-5-nano

# FastAPI URL used by the Streamlit UI.
TRANSCRIPTION_API_URL=http://127.0.0.1:8000

# Optional: set to mock to return sample data instead of transcribing audio.
# STT_BACKEND=mock
